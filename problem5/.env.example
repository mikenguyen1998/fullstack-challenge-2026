# ---------- App ----------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1
# Comma-separated list, or * to allow all
CORS_ORIGINS=*
TRUST_PROXY=false
LOG_LEVEL=debug

# ---------- Rate limit ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---------- Database (SQLite / Prisma) ----------
DATABASE_URL="file:./prisma/dev.db"

# ---------- Docs ----------
DOCS_ENABLED=true
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// The connection URL lives in prisma.config.ts (Prisma 7).
datasource db {
  provider = "sqlite"
}

model Resource {
  id          Int      @id @default(autoincrement())
  name        String
  /// normalizeSearch(name): lower-case, no accents. Used for case/accent-insensitive search.
  searchName  String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([searchName])
}
